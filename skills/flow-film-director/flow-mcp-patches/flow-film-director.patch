+// owner[tile] = index of the job whose prompt it holds, or -1. Scenes of one film share most of their text (tone,
+// identity lines), so only the words that appear in ONE job's prompt count. A tile goes to the job with the highest
+// share of its own words found; ties or weak matches (< 60 %) stay unassigned rather than guessed.
+export function assignByPrompt(jobPrompts: string[], tilePrompts: (string | undefined)[], capacity: number[]): number[] {
+  const bags = jobPrompts.map(words);
+  const own = bags.map((b, i) => new Set([...b].filter((w) => !bags.some((o, k) => k !== i && o.has(w)))));
+  const owner = tilePrompts.map(() => -1);
+  const left = [...capacity];
+  const pairs: { tile: number; job: number; score: number }[] = [];
+  tilePrompts.forEach((tp, tile) => {
+    if (!tp) return;
+    const have = words(tp);
+    own.forEach((set, job) => {
+      // identical prompts (two takes of one scene in one batch) have no own words: match them on all their words
+      const want = set.size ? set : bags[job];
+      const hit = [...want].filter((w) => have.has(w)).length;
+      pairs.push({ tile, job, score: want.size ? hit / want.size : 0 });
+    });
+  });
+  pairs.sort((a, b) => b.score - a.score);
+  for (const { tile, job, score } of pairs) {
+    if (score < 0.6 || owner[tile] >= 0 || left[job] <= 0) continue;
+    const rival = pairs.find((p) => p.tile === tile && p.job !== job && left[p.job] > 0 && own[p.job].size && own[job].size);
+    if (rival && rival.score === score) continue;
+    owner[tile] = job;
+    left[job]--;
+  }
+  return owner;
+}
